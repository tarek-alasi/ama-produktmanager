PORT=3001
NODE_ENV=development
APP_NAME=AMA Produktmanager

# Lokal: ./storage | PandaStack mit Volume: /data
STORAGE_ROOT=./storage
DATABASE_PATH=./storage/ama-produkte.sqlite

# Allgemeine Produktdatenquelle (Test: Open Food Facts)
PRODUCT_API_URL=https://world.openfoodfacts.org/api/v2/product/{ean}.json
# Alternativ mehrere Quellen, durch Semikolon getrennt:
PRODUCT_API_URLS=https://world.openfoodfacts.org/api/v2/product/{ean}.json
PRODUCT_API_KEY=
PRODUCT_API_KEY_HEADER=Authorization
PRODUCT_API_KEY_PREFIX=Bearer

# eBay: zuerst ausschließlich Sandbox verwenden
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Bei eBay hinterlegte OAuth Redirect URL / RuName (exakt übernehmen)
EBAY_REDIRECT_URI=
# Lange zufällige Zeichenfolge; später nicht ändern
EBAY_TOKEN_ENCRYPTION_KEY=
EBAY_MARKETPLACE_ID=EBAY_DE
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
